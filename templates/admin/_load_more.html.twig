{# Expects: page (LoadMorePage), route (name of the current index route),
   and optionally extra (query params to keep, e.g. {q: q}) #}
<div class="d-flex justify-content-between align-items-center mt-3">
    <span class="text-muted small">Показано {{ page.items|length }} з {{ page.total }}</span>
    {% if page.hasMore %}
        <a href="{{ path(route, (extra|default({}))|merge({show: page.nextLimit})) }}" class="btn btn-outline-secondary btn-sm">
            Показати ще ({{ page.remaining }})
        </a>
    {% endif %}
</div>
