{% extends 'base.html.twig' %}

{% block title %}Admin{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}

{% block body %}
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="{{ path('admin_dashboard') }}">Blacklist Admin</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="adminNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" href="{{ path('admin_region_index') }}">Regions</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('admin_driver_index') }}">Drivers</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('admin_blacklist_entry_index') }}">Blacklist</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('admin_driver_history_entry_index') }}">Driver History</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('admin_user_index') }}">Users</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('admin_telegram_user_index') }}">Telegram</a></li>
            </ul>
            <span class="navbar-text text-light-emphasis">
                {% if app.user %}
                    <a class="link-light" href="{{ path('admin_profile') }}">{{ app.user.name }}</a> ·
                {% else %}
                    guest ·
                {% endif %}
                <a class="link-light" href="{{ path('app_logout') }}">Logout</a>
            </span>
        </div>
    </div>
</nav>

<div class="container pb-5">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : 'success' }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {% block admin_body %}{% endblock %}
</div>
{% endblock %}
