{% extends 'admin/base.html.twig' %}

{% block admin_body %}
<div style="display:flex; justify-content:space-between; align-items:baseline;">
    <h1>Blacklist entries <small style="color:#888;">(latest 100)</small></h1>
    <a href="{{ path('admin_blacklist_entry_new') }}">+ New entry</a>
</div>

<table style="border-collapse:collapse; width:100%;">
    <thead>
        <tr style="text-align:left; border-bottom:2px solid #ccc;">
            <th style="padding:6px;">Driver</th>
            <th style="padding:6px;">Reason</th>
            <th style="padding:6px;">Reported by</th>
            <th style="padding:6px;">When</th>
            <th style="padding:6px;">Active</th>
            <th style="padding:6px;"></th>
        </tr>
    </thead>
    <tbody>
    {% for entry in entries %}
        <tr style="border-bottom:1px solid #eee;">
            <td style="padding:6px;">{{ entry.driver.fullName }}</td>
            <td style="padding:6px;">{{ entry.text|length > 60 ? entry.text[:60] ~ '…' : entry.text }}</td>
            <td style="padding:6px;">{{ entry.reporterName }}</td>
            <td style="padding:6px;">{{ entry.occurredAt ? entry.occurredAt|date('Y-m-d') : '—' }}</td>
            <td style="padding:6px;">{{ entry.isActive ? 'yes' : 'no' }}</td>
            <td style="padding:6px; white-space:nowrap;">
                <a href="{{ path('admin_blacklist_entry_edit', {id: entry.id}) }}">Edit</a>
                <form method="post" action="{{ path('admin_blacklist_entry_delete', {id: entry.id}) }}"
                      style="display:inline;" onsubmit="return confirm('Delete entry #{{ entry.id }}?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-blacklist-entry-' ~ entry.id) }}">
                    <button type="submit" style="border:0; background:none; color:#b91c1c; cursor:pointer;">Delete</button>
                </form>
            </td>
        </tr>
    {% else %}
        <tr><td colspan="6" style="padding:6px;">No entries.</td></tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}
