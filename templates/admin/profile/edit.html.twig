{% extends 'admin/base.html.twig' %}
{% block admin_body %}
    <h1 class="h3 mb-3">My profile</h1>
    <div class="card mb-3" style="max-width: 480px;"><div class="card-body">
        {{ form_start(form) }}
            {{ form_row(form.email) }}
            {{ form_row(form.name) }}
            <button type="submit" class="btn btn-primary">Save</button>
        {{ form_end(form) }}
    </div></div>

    <a href="{{ path('admin_profile_password') }}" class="btn btn-outline-secondary btn-sm">Change password</a>
{% endblock %}
