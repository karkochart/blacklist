{% extends 'admin/base.html.twig' %}

{% block admin_body %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Users</h1>
    <a href="{{ path('admin_user_new') }}" class="btn btn-primary btn-sm">+ New user</a>
</div>

<div class="list-group">
{% for user in page.items %}
    <div class="list-group-item d-flex justify-content-between align-items-start gap-2">
        <div>
            <div class="fw-semibold">{{ user.email }}</div>
            <div class="small text-muted">{{ user.name }} · {{ user.roles|join(', ') }}</div>
        </div>
        <div class="text-nowrap">
            <a href="{{ path('admin_user_edit', {id: user.id}) }}" class="btn btn-sm btn-outline-secondary">Edit</a>
            {% if user != app.user %}
                <form method="post" action="{{ path('admin_user_delete', {id: user.id}) }}"
                      class="d-inline" onsubmit="return confirm('Delete {{ user.email }}?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-user-' ~ user.id) }}">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
            {% endif %}
        </div>
    </div>
{% endfor %}
</div>

{{ include('admin/_load_more.html.twig', {page: page, route: 'admin_user_index'}) }}
{% endblock %}
